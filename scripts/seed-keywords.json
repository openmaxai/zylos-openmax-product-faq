    { "match": ["对话与群聊模式", "Conversations and Group Chat Modes"], "terms": ["群聊", "建群", "group chat", "@"] },
    { "match": ["自适应记忆", "Adaptive Memory"], "terms": ["记忆", "memory", "记住"] },
    { "match": ["IM 渠道连接", "IM Channel Connections"], "terms": ["渠道", "接入", "对接", "im", "channel", "connect"] },
    { "match": ["飞书", "Feishu"], "terms": ["飞书", "feishu"] },
    { "match": ["企业微信", "WeCom"], "terms": ["企业微信", "企微", "wecom"] },
    { "match": ["钉钉", "DingTalk"], "terms": ["钉钉", "dingtalk"] },
    { "match": ["微信", "WeChat"], "terms": ["微信", "wechat"] },
    { "match": ["Lark"], "terms": ["lark"] },
    { "match": ["Telegram"], "terms": ["telegram", "电报"] },
    { "match": ["WhatsApp"], "terms": ["whatsapp", "封号", "ban"] },
    { "match": ["Microsoft Teams"], "terms": ["teams", "microsoft teams"] },
    { "match": ["Slack"], "terms": ["slack"] },
    { "match": ["Discord"], "terms": ["discord"] },
    { "match": ["LINE"], "terms": ["line"] },
    { "match": ["Zalo"], "terms": ["zalo"] },
    { "match": ["订阅和套餐", "Subscriptions and Plans"], "terms": ["订阅", "subscription"] },
    { "match": ["Workspace 套餐", "Workspace Plans"], "terms": ["套餐", "价格", "多少钱", "收费", "怎么收费", "标准版", "旗舰版", "企业版", "plan", "plans", "price", "pricing", "cost", "how much"] },
    { "match": ["试用期", "Trial Period"], "terms": ["试用", "免费试用", "绑卡", "信用卡", "trial", "free trial", "credit card"] },
    { "match": ["升级 / 修改 / 取消", "Upgrade / Modify / Cancel"], "terms": ["升级套餐", "取消订阅", "退订", "降级", "差价", "cancel", "downgrade", "upgrade plan"] },
