    { "match": ["知识库", "Knowledge Base"], "terms": ["知识库", "文档", "资料", "上传文件", "knowledge base", "document", "upload"] },
    { "match": ["项目和任务", "Projects and Tasks"], "terms": ["项目", "任务", "验收", "project", "task"] },
    { "match": ["安全与合规", "Security and Compliance"], "terms": ["安全", "合规", "隐私", "训练", "soc2", "sso", "加密", "私有化", "security", "compliance", "privacy", "gdpr", "encryption", "on-premise"] },
    { "match": ["故障排查", "Troubleshooting"], "terms": ["报错", "不回复", "没反应", "限流", "失败", "离线", "连不上", "error", "not responding", "offline", "rate limit", "failed"] },
    { "match": ["转客服 / 升级", "Escalation to Customer Support"], "terms": ["退款", "合同", "发票", "对公", "人工", "客服", "联系", "投诉", "refund", "contract", "invoice", "human", "support", "contact", "complaint"] },
    { "match": ["使用限制 / 暂不支持", "Usage Limitations"], "terms": ["暂不支持", "不支持", "限制", "发票", "增值税", "sso", "mcp", "limitation", "not supported", "vat"] }
  ]
}
