{
  "_comment": "Built-in fallback anchors for `kb.js ask`. `match` = section title prefixes (numbering/punctuation ignored, zh or en); `terms` are added to every matching section with seed weight. Content-team-maintained keywords.yml in openmax-product-kb takes precedence in weight; these keep ask usable when it is missing or invalid.",
  "exclude_titles": ["更新记录", "Changelog"],
  "anchors": [
    { "match": ["快速开始", "Quick Start"], "terms": ["怎么用", "如何使用", "上手", "入门", "第一次", "新手", "教程", "注册", "getting started", "tutorial", "onboarding", "how to use", "sign up"] },
    { "match": ["A · 产品是什么", "产品是什么", "What the Product Is"], "terms": ["是什么", "openmax是什么", "介绍", "产品定位", "chatgpt", "区别", "what is openmax", "difference"] },
    { "match": ["能力边界", "Capability Scope"], "terms": ["能做什么", "能干什么", "能力", "capabilities", "what can"] },
    { "match": ["AI Agent", "员工类型", "Employee Types"], "terms": ["数字员工", "digital employee", "轻量型", "标准型", "lightweight"] },
    { "match": ["雇佣员工", "Hiring Employees"], "terms": ["创建员工", "新建员工", "雇佣", "外接机器人", "create agent", "hire"] },
    { "match": ["Agent 状态", "Agent States"], "terms": ["休眠", "暂停", "唤醒", "pause", "hibernate", "resume", "wake"] },
